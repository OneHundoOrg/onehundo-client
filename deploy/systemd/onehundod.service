[Unit]
Description=OneHundo Local Achievement Daemon (onehundod)
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ONEHUNDO_PLATFORM_URL=https://onehundo.org
ExecStart=%h/.local/bin/onehundod
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
